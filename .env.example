# Copy to .env (git-ignored) and fill in. Never commit .env.
# Deploy scripts read PRIVATE_KEY with vm.envUint; it is never passed on the command line.

# --- Wallet ---------------------------------------------------------------
PRIVATE_KEY=

# --- RPC endpoints ----------------------------------------------------------
# Testnet
BASE_SEPOLIA_RPC=https://sepolia.base.org
UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
LASNA_RPC=https://lasna-rpc.rnk.dev/
# Mainnet
BASE_RPC=https://mainnet.base.org
ARBITRUM_RPC=https://arb1.arbitrum.io/rpc
REACTIVE_RPC=https://mainnet-rpc.rnk.dev/

# --- Chain IDs ----------------------------------------------------------------
BASE_SEPOLIA_CHAIN_ID=84532
UNICHAIN_SEPOLIA_CHAIN_ID=1301
LASNA_CHAIN_ID=5318007
BASE_CHAIN_ID=8453
ARBITRUM_CHAIN_ID=42161
REACTIVE_CHAIN_ID=1597

# --- Reactive Network -----------------------------------------------------------
# Omni system contract (same address on Lasna and mainnet).
REACTIVE_SYSTEM_CONTRACT=0x8888888888888888888888888888888888888888
# Legacy system contract that emits the CronN events (subscribe to cron here).
REACTIVE_LEGACY_SYSTEM_CONTRACT=0x0000000000000000000000000000000000fffFfF

# --- Callback proxies (recheck on the docs "Origins & Destinations" page before every deploy) ---
# Last checked: 2026-11-13 against Reactive-Network/documentation @ 2026-11-10
BASE_SEPOLIA_CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
UNICHAIN_SEPOLIA_CALLBACK_PROXY=0x775c9B990ADe401060B78D0e98684eEf8d2466C1
BASE_CALLBACK_PROXY=0xCc780DdE33f56f55dE778D42c930959374a4a068
ARBITRUM_CALLBACK_PROXY=0xaee8d2deBaB5bE353bfec167C58a549923892e11

# --- lREACT faucet (send Sepolia ETH, 1 ETH -> 100 lREACT, max 5 ETH per send) ---
LASNA_FAUCET_BASE_SEPOLIA=0x2afaFD298b23b62760711756088F75B7409f5967
LASNA_FAUCET_ETH_SEPOLIA=0x9b9BB25f1A81078C544C829c5EB7822d747Cf434

# --- Explorer API keys (contract verification) --------------------------------------
BASESCAN_API_KEY=
ARBISCAN_API_KEY=

# --- Tokens ---------------------------------------------------------------------------
# Native USDC on Base mainnet (Circle). Testnet deploys use MockUSDC instead.
BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# --- Deploy settings. Optional values are commented out: unset means "use the default in brackets". ---
# ETH float sent to the shared executor for callback fees [0.001 ether]
# EXECUTOR_FUNDING_WEI=
# Must be true for any script to touch Base or Reactive mainnet. Set only after an explicit "deploy to mainnet".
STEWARD_MAINNET_APPROVED=false

# --- Your rules (read by DeployRulebook and CreateVault) -----------------------------
# Comma-separated income senders whose USDC payments get split (required for DeployRulebook)
# INCOME_SENDERS=
# Share saved, in basis points: 100 = 1% ... 5000 = 50% [2000]
# SPLIT_BPS=
# Most USDC (6 decimals) Rule 1 may save per period [100000000 = 100 USDC]
# PERIOD_CAP=
# Period length in seconds [2592000 = 30 days]
# PERIOD_LENGTH=
# Cron topic for your Rulebook [Cron100 on Lasna, Cron1000 on mainnet]; 0 = none
# RULEBOOK_CRON=
# REACT/lREACT sent with the Rulebook deploy to pay for its reactive txs [0.5 ether]
# RULEBOOK_FUNDING_WEI=
# Who receives the vault after a full Guardian cycle (required for CreateVault)
# BENEFICIARY=
# Total USDC the executor may ever pull for Rule 1, signed as a permit [1000000000 = 1,000 USDC]
# PERMIT_CAP=

# --- Rule 2: claim and secure (read by DeployRulebook) --------------------------------
# Your OpenZeppelin VestingWallet and the token it holds; leave VESTING empty to turn Rule 2 off
# VESTING=
# VESTING_TOKEN=
# Seconds between claim checks [86400 = 1 day]
# CLAIM_INTERVAL=

# --- Rule 3: Guardian (read by DeployRulebook) -----------------------------------------
# Seconds of silence before a warning [7776000 = 90 days]; 0 turns the Guardian off
# SILENCE_PERIOD=
# Seconds of warning before the vault goes to BENEFICIARY [1209600 = 14 days]
# GRACE_PERIOD=
# Seconds between Guardian checks on cron [3600 = 1 hour]
# GUARDIAN_CHECK_INTERVAL=
# Comma-separated chain IDs where your activity counts [Base Sepolia,Unichain Sepolia on Lasna; Base,Arbitrum on mainnet]
# WATCHED_CHAINS=

# --- Ops scripts (make alive, withdraw, top-up-react, ...) ---------------------------
# COLD_WALLET=
# WITHDRAW_TOKEN=
# WITHDRAW_AMOUNT=
# TOP_UP_WEI=
# Any Rulebook address, for make check-now on someone else's Rulebook [yours]
# RULEBOOK=

# ---- Web page (web/) ----
# Optional: a WalletConnect Cloud project id adds mobile and WalletConnect wallets to the page.
# Without it the page works with browser wallets (MetaMask, including MetaMask's mobile browser).
# Put it in web/.env.local, not here, when running the page locally.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
